# OceanBase development tenant
OCEANBASE_VERSION=4.3.5-lts
OCEANBASE_MODE=slim
OCEANBASE_MEMORY_LIMIT=4G
OCEANBASE_CPU_COUNT=4
OCEANBASE_TENANT_PASSWORD=xanze_dev_ob_password

# Single public entrypoint; databases and APIs stay on the Compose network.
WEB_PORT=13080

# Development-only JWT signing key (replace outside local development)
XANZE_JWT_SECRET=phase-01-development-signing-key-change-before-production
XANZE_JWT_TTL=PT8H

# Idempotent development seed. Passwords are injected, never embedded in code.
XANZE_DEV_SEED_ENABLED=true
XANZE_DEV_ADMIN_USERNAME=admin
XANZE_DEV_ADMIN_PASSWORD=Admin123!
XANZE_DEV_EMPLOYEE_USERNAME=employee
XANZE_DEV_EMPLOYEE_PASSWORD=Employee123!
